{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-mcp",
  "account_id": "ab9f6d8988145943bf8bbab313e45e6e",
  "routes": [{ "pattern": "whatsapp.robsonlins.com", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "OAUTH_COORDINATOR", "class_name": "OAuthCoordinator" }],
  },
  "migrations": [{ "tag": "oauth-authority-v1", "new_sqlite_classes": ["OAuthCoordinator"] }],
  "services": [
    { "binding": "ASSISTANT_INGRESS", "service": "personal-assistant-shadow" },
    { "binding": "ASSISTANT_OWNER", "service": "personal-assistant-shadow", "entrypoint": "OwnerAssistant" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whatsapp-mcp-private",
      "database_id": "43e62922-40f7-4fb8-8544-8b7f13c693b0",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "whatsapp-mcp-private-media" },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "93907348ac84473c949f9400b0c796ba" },
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "RUNTIME_CONFIG": "database",
    // Non-secret affinity and discovery settings must survive normal deploys.
    // Keep these pinned to the existing assistant installation, never regenerate.
    "ASSISTANT_INSTALLATION_ID": "personal-shadow-20261026",
    "ASSISTANT_GENERATION": "shadow-g1-20261026",
    "ASSISTANT_KNOWLEDGE_ENABLED": "true",
    "ASSISTANT_BRIDGE_BATCH_SIZE": "100",
    "GPT_PLUGIN_URL": "https://chatgpt.com/plugins/plugin_asdk_app_6ad665e79d8c81919153d6c969ee9d64",
    "PUBLIC_ORIGIN": "https://whatsapp.robsonlins.com",
    "ACCESS_ISSUER": "https://orobsonn.cloudflareaccess.com",
    "ACCESS_AUD": "059c5acda78277bb1525f1900a6765d75befb4c3525ad26a3c954c15477b75c6",
    "CONNECTION_GENERATION": "pending",
    "CONNECTED_PHONE": "",
    "MEDIA_HOSTS": "f004.backblazeb2.com",
    "TRANSCRIPTION_ENABLED": "true",
    // Owner-selected enrolled voice; generation stays on the free model only.
    // FISH_API_KEY remains a Worker secret, never committed here.
    "TTS_ENABLED": "true",
    "FISH_TTS_MODEL": "s2.1-pro-free",
    "FISH_VOICE_ID": "cde19c3c18d1432b8ebd30ab143b4823",
    "FISH_VOICE_NAME": "Robson — Jovem simpático",
    "AUTO_TRANSCRIPTION_ENABLED": "true",
    "MAINTENANCE": "false",
  },
}
