{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "personal-assistant-shadow",
  "main": "index.ts",
  "compatibility_date": "2026-10-25",
  "workers_dev": false,
  "preview_urls": false,
  // Local/dry-run configuration only. No production routes, bindings, or secrets.
  // CogneeContainer/CogneeBroker are exported but remain unbound here.
  // Isolated homologation must explicitly configure durable_object scheduling,
  // image alias cognee, SQLite DO binding COGNEE and its own DB/namespace/secrets.
  "observability": { "enabled": false }
}
